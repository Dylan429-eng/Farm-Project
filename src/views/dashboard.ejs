<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Bienvenue - Ferme ManyChicks</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    
    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 20px;
    }
    
    .container {
      text-align: center;
      max-width: 600px;
    }
    
    .logo {
      font-size: 5em;
      margin-bottom: 20px;
      animation: bounce 2s ease-in-out infinite;
    }
    
    @keyframes bounce {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(-10px); }
    }
    
    h1 {
      color: white;
      font-size: 3em;
      margin-bottom: 15px;
      text-shadow: 2px 2px 4px rgba(0,0,0,0.2);
    }
    
    .subtitle {
      color: rgba(255,255,255,0.9);
      font-size: 1.3em;
      margin-bottom: 50px;
      line-height: 1.6;
    }
    
    .buttons {
      display: flex;
      gap: 30px;
      justify-content: center;
      flex-wrap: wrap;
    }
    
    .btn {
      display: inline-block;
      padding: 20px 50px;
      border-radius: 15px;
      text-decoration: none;
      font-weight: 700;
      font-size: 1.2em;
      transition: all 0.3s ease;
      min-width: 200px;
    }
    
    .btn-register {
      background: white;
      color: #667eea;
      box-shadow: 0 10px 30px rgba(0,0,0,0.2);
    }
    
    .btn-register:hover {
      transform: translateY(-5px);
      box-shadow: 0 15px 40px rgba(0,0,0,0.3);
    }
    
    .btn-login {
      background: transparent;
      color: white;
      border: 3px solid white;
    }
    
    .btn-login:hover {
      background: white;
      color: #667eea;
      transform: translateY(-5px);
    }
    
    .features {
      margin-top: 60px;
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
      gap: 20px;
    }
    
    .feature {
      background: rgba(255,255,255,0.15);
      backdrop-filter: blur(10px);
      padding: 25px;
      border-radius: 15px;
      color: white;
      transition: all 0.3s;
    }
    
    .feature:hover {
      background: rgba(255,255,255,0.25);
      transform: translateY(-5px);
    }
    
    .feature-icon {
      font-size: 2.5em;
      margin-bottom: 15px;
    }
    
    .feature-title {
      font-weight: 600;
      margin-bottom: 8px;
    }
    
    .feature-desc {
      font-size: 0.9em;
      opacity: 0.85;
    }
    
    .footer {
      margin-top: 50px;
      color: rgba(255,255,255,0.6);
      font-size: 0.9em;
    }
  </style>
</head>
<body>
  <div class="container">
    <div class="logo">🐔</div>
    
    <h1>Ferme du Vatican</h1>
    <p class="subtitle">
      Système de gestion avicole intelligent<br>
      Suivez, analysez et optimisez votre production
    </p>
    
    <div class="buttons">
      <a href="/register" class="btn btn-register">📝 S'inscrire</a>
      <a href="/login" class="btn btn-login">🔐 Connexion</a>
    </div>
    
    <div class="features">
      <div class="feature">
        <div class="feature-icon">🐣</div>
        <div class="feature-title">Gestion des Lots</div>
        <div class="feature-desc">Suivez vos poussins de l'arrivée à la vente</div>
      </div>
      
      <div class="feature">
        <div class="feature-icon">📡</div>
        <div class="feature-title">IoT & Capteurs</div>
        <div class="feature-desc">Monitoring en temps réel</div>
      </div>
      
      <div class="feature">
        <div class="feature-icon">🚨</div>
        <div class="feature-title">Alertes Intelligentes</div>
        <div class="feature-desc">Restez informé de tout</div>
      </div>
    </div>
    
    <div class="footer">
      © 2026 Ferme ManyChicks - Tous droits réservés
    </div>
  </div>
</body>
</html>
