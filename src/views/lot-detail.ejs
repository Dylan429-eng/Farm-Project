<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title>Détails du Lot - Ferme ManyChicks</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    
    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      min-height: 100vh;
      padding: 16px;
    }
    
    /* Responsive navbar */
    .navbar {
      background: white;
      border-radius: 16px;
      padding: 16px 20px;
      margin-bottom: 20px;
      box-shadow: 0 5px 20px rgba(0,0,0,0.1);
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      align-items: center;
      gap: 15px;
    }
    
    .navbar-brand {
      font-size: 1.3em;
      font-weight: bold;
      color: #667eea;
      text-decoration: none;
    }
    
    .navbar-menu {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      list-style: none;
    }
    
    .navbar-menu a {
      text-decoration: none;
      color: #333;
      padding: 8px 14px;
      border-radius: 8px;
      transition: all 0.3s;
      font-size: 0.9em;
    }
    
    .navbar-menu a:hover, .navbar-menu a.active {
      background: #667eea;
      color: white;
    }
    
    /* Container responsive */
    .container {
      background: white;
      border-radius: 20px;
      box-shadow: 0 20px 60px rgba(0,0,0,0.3);
      padding: 24px 20px;
      width: 100%;
      max-width: 1400px;
      margin: 0 auto;
    }
    
    /* Responsive tablette */
    @media (min-width: 768px) {
      body { padding: 20px; }
      .container { padding: 40px; }
      .navbar-brand { font-size: 1.5em; }
    }
    
    /* Responsive desktop */
    @media (min-width: 1024px) {
      body { padding: 30px; }
      .container { padding: 40px; }
    }
    
    /* Breadcrumb responsive */
    .breadcrumb {
      color: #6b7280;
      margin-bottom: 20px;
      font-size: 0.85em;
      word-break: break-word;
    }
    
    /* Header section responsive */
    .lot-header {
      display: flex;
      flex-direction: column;
      gap: 15px;
      margin-bottom: 30px;
    }
    
    @media (min-width: 768px) {
      .lot-header {
        flex-direction: row;
        justify-content: space-between;
        align-items: start;
      }
    }
    
    .lot-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
    }
    
    h1 {
      color: #333;
      font-size: 1.8em;
      word-break: break-word;
    }
    
    @media (min-width: 768px) {
      h1 { font-size: 2.2em; }
    }
    
    @media (min-width: 1024px) {
      h1 { font-size: 2.5em; }
    }
    
    .subtitle {
      color: #666;
      margin-bottom: 20px;
      font-size: 1em;
    }
    
    /* Info grid responsive */
    .info-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
      gap: 16px;
      margin-bottom: 30px;
    }
    
    @media (min-width: 480px) {
      .info-grid { grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); }
    }
    
    @media (min-width: 768px) {
      .info-grid { gap: 20px; }
    }
    
    .info-card {
      background: #f8f9fa;
      padding: 16px;
      border-radius: 12px;
      border-left: 4px solid #667eea;
    }
    
    @media (min-width: 768px) {
      .info-card { padding: 20px; }
    }
    
    .info-card h3 {
      font-size: 0.85em;
      color: #6b7280;
      margin-bottom: 8px;
    }
    
    .info-card .value {
      font-size: 1.5em;
      font-weight: bold;
      color: #333;
      word-break: break-word;
    }
    
    @media (min-width: 768px) {
      .info-card .value { font-size: 1.8em; }
    }
    
    /* Section responsive */
    .section {
      margin-top: 30px;
    }
    
    .section-header {
      display: flex;
      flex-direction: column;
      gap: 15px;
      margin-bottom: 20px;
      padding-bottom: 10px;
      border-bottom: 2px solid #667eea;
    }
    
    @media (min-width: 480px) {
      .section-header {
        flex-direction: row;
        justify-content: space-between;
        align-items: center;
      }
    }
    
    .section-header h2 {
      color: #667eea;
      font-size: 1.3em;
    }
    
    @media (min-width: 768px) {
      .section-header h2 { font-size: 1.5em; }
    }
    
    /* Table responsive */
    .table-container {
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
    }
    
    .table {
      width: 100%;
      border-collapse: collapse;
      min-width: 500px;
    }
    
    @media (max-width: 480px) {
      .table { font-size: 0.85em; }
    }
    
    /* Progress bar responsive */
    .progress-bar {
      width: 100%;
      height: 30px;
      background: #e5e7eb;
      border-radius: 15px;
      overflow: hidden;
      margin-top: 10px;
    }
    
    .progress-fill {
      height: 100%;
      background: linear-gradient(90deg, #667eea 0%, #764ba2 100%);
      display: flex;
      align-items: center;
      justify-content: center;
      color: white;
      font-weight: 600;
      font-size: 0.8em;
      transition: width 0.3s ease;
    }
    
    /* Buttons responsive */
    .btn {
      display: inline-block;
      padding: 10px 20px;
      border-radius: 8px;
      text-decoration: none;
      font-weight: 600;
      transition: all 0.3s;
      border: none;
      cursor: pointer;
      font-size: 0.9em;
      text-align: center;
    }
    
    @media (min-width: 768px) {
      .btn { padding: 12px 24px; font-size: 1em; }
    }
    
    .btn-primary {
      background: #667eea;
      color: white;
    }
    
    .btn-primary:hover {
      background: #5568d3;
    }
    
    .btn-success {
      background: #10b981;
      color: white;
    }
    
    .btn-danger {
      background: #ef4444;
      color: white;
    }
    
    .badge {
      display: inline-block;
      padding: 5px 14px;
      border-radius: 12px;
      font-size: 0.85em;
      font-weight: 600;
    }
    
    .badge-success {
      background: #d1fae5;
      color: #065f46;
    }
    
    .badge-warning {
      background: #fef3c7;
      color: #92400e;
    }
  </style>
</head>
<body>
  <nav class="navbar">
    <a href="/dashboard" class="navbar-brand">🐔 Ferme ManyChicks</a>
    <ul class="navbar-menu">
      <li><a href="/dashboard">Dashboard</a></li>
      <li><a href="/lots" class="active">Lots</a></li>
      <li><a href="/alerts">Alertes</a></li>
      <li><a href="/login">Connexion</a></li>
    </ul>
  </nav>

  <div class="container">
    <div class="breadcrumb">
      <a href="/dashboard">Dashboard</a> / <a href="/lots">Lots</a> / <%= lot.nom_lot %>
    </div>

    <div class="lot-header">
      <div>
        <h1>🐣 <%= lot.nom_lot %></h1>
        <p class="subtitle">
          <span class="badge <%= lot.statut === 'actif' ? 'badge-success' : 'badge-warning' %>">
            <%= lot.statut === 'actif' ? 'Actif' : 'Terminé' %>
          </span>
        </p>
      </div>
      <div class="lot-actions">
        <a href="/lots/<%= lot.id %>/edit" class="btn btn-primary">Modifier</a>
        <a href="/lots/<%= lot.id %>/report" class="btn btn-success">Rapport</a>
      </div>
    </div>

    <div class="info-grid">
      <div class="info-card">
        <h3>Nombre Initial</h3>
        <div class="value"><%= lot.nombre_initial %></div>
      </div>
      <div class="info-card">
        <h3>Nombre Actuel</h3>
        <div class="value"><%= lot.nombre_actuel %></div>
      </div>
      <div class="info-card">
        <h3>Âge</h3>
        <div class="value"><%= lot.age_jours || 0 %> jours</div>
      </div>
      <div class="info-card">
        <h3>Taux de Mortalité</h3>
        <div class="value"><%= lot.taux_mortalite || 0 %>%</div>
      </div>
      <div class="info-card">
        <h3>CPS</h3>
        <div class="value"><%= lot.cps || 0 %>€</div>
      </div>
      <div class="info-card">
        <h3>PDS</h3>
        <div class="value"><%= lot.pds || 0 %>€</div>
      </div>
    </div>

    <% var progression = Math.round(((lot.age_jours || 0) / (lot.duree_prevue || 42)) * 100); %>
    <% if (progression > 100) progression = 100; %>
    <div class="section">
      <div class="section-header">
        <h2>Progression du Lot</h2>
      </div>
      <div>
        <p><strong>Durée prévue:</strong> <%= lot.duree_prevue || 42 %> jours</p>
        <div class="progress-bar">
          <div class="progress-fill" data-progress="<%= progression %>">
            <%= progression %>%
          </div>
        </div>
      </div>
    </div>

    <div class="section">
      <div class="section-header">
        <h2>Historique de Mortalité</h2>
        <a href="/lots/<%= lot.id %>/mortality/add" class="btn btn-primary">+ Ajouter</a>
      </div>
      <% if (mortalityHistory && mortalityHistory.length > 0) { %>
        <div class="table-container">
          <table class="table">
            <thead>
              <tr><th>Date</th><th>Nombre</th><th>Cause</th><th>Notes</th></tr>
            </thead>
            <tbody>
              <% mortalityHistory.forEach(function(record) { %>
                <tr>
                  <td><%= new Date(record.date).toLocaleDateString('fr-FR') %></td>
                  <td><%= record.nombre %></td>
                  <td><%= record.cause || 'Non spécifiée' %></td>
                  <td><%= record.notes || '-' %></td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } else { %>
        <p style="color: #6b7280; text-align: center; padding: 40px;">Aucun enregistrement de mortalité</p>
      <% } %>
    </div>

    <div class="section">
      <div class="section-header">
        <h2>Coûts</h2>
      </div>
      <div class="info-grid">
        <div class="info-card">
          <h3>Coût Alimentation</h3>
          <div class="value"><%= lot.cout_alimentation || 0 %>€</div>
        </div>
        <div class="info-card">
          <h3>Coût Santé</h3>
          <div class="value"><%= lot.cout_sante || 0 %>€</div>
        </div>
        <div class="info-card">
          <h3>Autres Coûts</h3>
          <div class="value"><%= lot.autres_couts || 0 %>€</div>
        </div>
        <div class="info-card">
          <h3>Coût Total</h3>
          <div class="value"><%= (lot.cout_alimentation || 0) + (lot.cout_sante || 0) + (lot.autres_couts || 0) %>€</div>
        </div>
      </div>
    </div>
  </div>
  <script>
    document.querySelectorAll('.progress-fill').forEach(function(el) {
      let progress = el.dataset.progress;
      el.style.width = Math.min(100, Math.max(0, progress)) + '%';
    });
  </script>
</body>
</html>