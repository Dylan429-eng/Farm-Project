<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Détails du Lot - Ferme ManyChicks</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      min-height: 100vh;
      padding: 20px;
    }
    .navbar {
      background: white;
      border-radius: 15px;
      padding: 20px 30px;
      margin-bottom: 20px;
      box-shadow: 0 5px 20px rgba(0,0,0,0.1);
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .navbar-brand {
      font-size: 1.5em;
      font-weight: bold;
      color: #667eea;
      text-decoration: none;
    }
    .navbar-menu {
      display: flex;
      gap: 20px;
      list-style: none;
    }
    .navbar-menu a {
      text-decoration: none;
      color: #333;
      padding: 8px 16px;
      border-radius: 8px;
      transition: all 0.3s;
    }
    .navbar-menu a:hover, .navbar-menu a.active {
      background: #667eea;
      color: white;
    }
    .container {
      background: white;
      border-radius: 20px;
      box-shadow: 0 20px 60px rgba(0,0,0,0.3);
      padding: 40px;
      max-width: 1400px;
      margin: 0 auto;
    }
    .breadcrumb {
      color: #6b7280;
      margin-bottom: 20px;
    }
    .breadcrumb a {
      color: #667eea;
      text-decoration: none;
    }
    h1 {
      color: #333;
      margin-bottom: 10px;
      font-size: 2.5em;
    }
    .subtitle {
      color: #666;
      margin-bottom: 30px;
      font-size: 1.1em;
    }
    .info-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 20px;
      margin-bottom: 30px;
    }
    .info-card {
      background: #f8f9fa;
      padding: 20px;
      border-radius: 12px;
      border-left: 4px solid #667eea;
    }
    .info-card h3 {
      font-size: 0.9em;
      color: #6b7280;
      margin-bottom: 10px;
    }
    .info-card .value {
      font-size: 1.8em;
      font-weight: bold;
      color: #333;
    }
    .section {
      margin-top: 40px;
    }
    .section-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 20px;
      padding-bottom: 10px;
      border-bottom: 2px solid #667eea;
    }
    .section-header h2 {
      color: #667eea;
      font-size: 1.5em;
    }
    .btn {
      display: inline-block;
      padding: 12px 24px;
      border-radius: 8px;
      text-decoration: none;
      font-weight: 600;
      transition: all 0.3s;
      border: none;
      cursor: pointer;
      font-size: 1em;
    }
    .btn-primary {
      background: #667eea;
      color: white;
    }
    .btn-primary:hover {
      background: #5568d3;
    }
    .btn-success {
      background: #10b981;
      color: white;
    }
    .btn-danger {
      background: #ef4444;
      color: white;
    }
    .badge {
      display: inline-block;
      padding: 6px 16px;
      border-radius: 12px;
      font-size: 0.9em;
      font-weight: 600;
    }
    .badge-success {
      background: #d1fae5;
      color: #065f46;
    }
    .badge-warning {
      background: #fef3c7;
      color: #92400e;
    }
    .table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 20px;
    }
    .table th,
    .table td {
      padding: 12px;
      text-align: left;
      border-bottom: 1px solid #e5e7eb;
    }
    .table th {
      background: #f3f4f6;
      font-weight: 600;
      color: #374151;
    }
    .table tr:hover {
      background: #f9fafb;
    }
    .progress-bar {
      width: 100%;
      height: 30px;
      background: #e5e7eb;
      border-radius: 15px;
      overflow: hidden;
      margin-top: 10px;
    }
    .progress-fill {
      height: 100%;
      background: linear-gradient(90deg, #667eea 0%, #764ba2 100%);
      display: flex;
      align-items: center;
      justify-content: center;
      color: white;
      font-weight: 600;
      font-size: 0.9em;
    }
  </style>
</head>
<body>
  <!-- Navigation -->
  <nav class="navbar">
    <a href="/dashboard" class="navbar-brand">🐔 Ferme ManyChicks</a>
    <ul class="navbar-menu">
      <li><a href="/dashboard">Dashboard</a></li>
      <li><a href="/lots" class="active">Lots</a></li>
      <li><a href="/alerts">Alertes</a></li>
      <li><a href="/login">Connexion</a></li>
    </ul>
  </nav>

  <div class="container">
    <div class="breadcrumb">
      <a href="/dashboard">Dashboard</a> / <a href="/lots">Lots</a> / <%= lot.nom_lot %>
    </div>

    <div style="display: flex; justify-content: space-between; align-items: start; margin-bottom: 30px;">
      <div>
        <h1>🐣 <%= lot.nom_lot %></h1>
        <p class="subtitle">
          <span class="badge <%= lot.statut === 'actif' ? 'badge-success' : 'badge-warning' %>">
            <%= lot.statut === 'actif' ? 'Actif' : 'Terminé' %>
          </span>
        </p>
      </div>
      <div style="display: flex; gap: 10px;">
        <a href="/lots/<%= lot.id %>/edit" class="btn btn-primary">Modifier</a>
        <a href="/lots/<%= lot.id %>/report" class="btn btn-success">Rapport</a>
      </div>
    </div>

    <!-- Informations principales -->
    <div class="info-grid">
      <div class="info-card">
        <h3>Nombre Initial</h3>
        <div class="value"><%= lot.nombre_initial %></div>
      </div>
      <div class="info-card">
        <h3>Nombre Actuel</h3>
        <div class="value"><%= lot.nombre_actuel %></div>
      </div>
      <div class="info-card">
        <h3>Âge</h3>
        <div class="value"><%= lot.age_jours || 0 %> jours</div>
      </div>
      <div class="info-card">
        <h3>Taux de Mortalité</h3>
        <div class="value"><%= lot.taux_mortalite || 0 %>%</div>
      </div>
      <div class="info-card">
        <h3>CPS</h3>
        <div class="value"><%= lot.cps || 0 %>€</div>
      </div>
      <div class="info-card">
        <h3>PDS</h3>
        <div class="value"><%= lot.pds || 0 %>€</div>
      </div>
    </div>

    <!-- Progression -->
    <% var progression = Math.round(((lot.age_jours || 0) / (lot.duree_prevue || 42)) * 100); %>
    <% if (progression > 100) progression = 100; %>
    <div class="section">
      <div class="section-header">
        <h2>Progression du Lot</h2>
      </div>
      <div>
        <p><strong>Durée prévue:</strong> <%= lot.duree_prevue || 42 %> jours</p>
        <div class="progress-bar">
          <div class="progress-fill" data-progress="<%= progression %>">
            <%= progression %>% de进展
          </div>
        </div>
      </div>
    </div>
    <script>
      document.querySelectorAll('.progress-fill').forEach(function(el) {
        el.style.width = el.dataset.progress + '%';
      });
    </script>

    <!-- Historique de mortalité -->
    <div class="section">
      <div class="section-header">
        <h2>Historique de Mortalité</h2>
        <a href="/lots/<%= lot.id %>/mortality/add" class="btn btn-primary">+ Ajouter</a>
      </div>
      <% if (mortalityHistory && mortalityHistory.length > 0) { %>
        <table class="table">
          <thead>
            <tr>
              <th>Date</th>
              <th>Nombre</th>
              <th>Cause</th>
              <th>Notes</th>
            </tr>
          </thead>
          <tbody>
            <% mortalityHistory.forEach(function(record) { %>
              <tr>
                <td><%= new Date(record.date).toLocaleDateString('fr-FR') %></td>
                <td><%= record.nombre %></td>
                <td><%= record.cause || 'Non spécifiée' %></td>
                <td><%= record.notes || '-' %></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      <% } else { %>
        <p style="color: #6b7280; text-align: center; padding: 40px;">Aucun enregistrement de mortalité</p>
      <% } %>
    </div>

    <!-- Coûts -->
    <div class="section">
      <div class="section-header">
        <h2>Coûts</h2>
      </div>
      <div class="info-grid">
        <div class="info-card">
          <h3>Coût Alimentation</h3>
          <div class="value"><%= lot.cout_alimentation || 0 %>€</div>
        </div>
        <div class="info-card">
          <h3>Coût Santé</h3>
          <div class="value"><%= lot.cout_sante || 0 %>€</div>
        </div>
        <div class="info-card">
          <h3>Autres Coûts</h3>
          <div class="value"><%= lot.autres_couts || 0 %>€</div>
        </div>
        <div class="info-card">
          <h3>Coût Total</h3>
          <div class="value"><%= (lot.cout_alimentation || 0) + (lot.cout_sante || 0) + (lot.autres_couts || 0) %>€</div>
        </div>
      </div>
    </div>
  </div>
</body>
</html>
